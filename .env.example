DIRECTUS_URL=https://your-directus-instance.example.com
DIRECTUS_TOKEN=
PUBLIC_DIRECTUS_URL=https://your-directus-instance.example.com
PUBLIC_SITE_URL=https://your-site.example.com

# Optional — leave HCAPTCHA_SECRET_KEY unset and verifyCaptcha() no-ops (forms still submit,
# just without a server-side captcha check). PUBLIC_HCAPTCHA_SITE_KEY alone is enough to
# render the widget client-side.
HCAPTCHA_SECRET_KEY=
PUBLIC_HCAPTCHA_SITE_KEY=
